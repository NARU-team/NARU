<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량용(AAOS) 앱임을 알린다. 개발 중에는 일반 에뮬레이터에서도 설치되도록 required=false -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- 중계 서버 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vehicle SDK: 공조(조회/제어) -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- Vehicle SDK: 배터리 잔량 조회 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Vehicle SDK: 조명(조회/제어) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- FusedLocation SDK: 차량 위치 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- TextToSpeech SDK: 멘트 음성 출력 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- SpeechToText SDK: 발화 해석 음성 입력 (SDK가 확인하는 권한, 이슈 #27) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- AAOS: 기어(GEAR_SELECTION) 조회. 에뮬레이터에서 이 권한으로 조회 확인(2026-11-13) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- AAOS: 바깥 온도(ENV_OUTSIDE_TEMPERATURE), 홈 화면 칩 (이슈 #33) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />

    <!-- Android 11+ 패키지 가시성: Pleos 차량 서비스 설치 여부를 확인하려면 미리 선언해야 한다 -->
    <queries>
        <package android:name="ai.pleos.playground.service.vehicle" />
        <!-- FusedLocation isSupported(): 위치 서비스 설치 여부 확인 (이슈 #44) -->
        <package android:name="ai.pleos.playground.service.location.fused" />
    </queries>

    <application
        android:name=".NaruApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Naru">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
